<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Student ERP Management System</title>
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Chart.js CDN for Visual Analytics -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body class="bg-slate-100 min-h-screen flex flex-col font-sans text-slate-800">
  
  <!-- Top Navigation Bar -->
  <% if (typeof user !== 'undefined' && user) { %>
    <nav class="bg-slate-900 text-white px-6 py-4 flex justify-between items-center shadow-md">
      <div class="flex items-center gap-3">
        <span class="text-xl font-bold tracking-wide text-blue-400">CampusERP</span>
        <span class="bg-slate-800 text-xs text-slate-300 font-mono px-2.5 py-1 rounded-full uppercase"><%= user.role %> Portal</span>
      </div>
      <div class="flex items-center gap-4 text-sm">
        <span class="text-slate-300">Logged in as: <strong class="text-white"><%= user.name %></strong></span>
        <a href="/auth/logout" class="bg-rose-600 hover:bg-rose-700 text-white font-semibold px-3 py-1.5 rounded-lg text-xs transition">Logout</a>
      </div>
    </nav>
  <% } %>

  <!-- Main Content Container -->
  <main class="flex-1 max-w-7xl w-full mx-auto p-6">
    <%- body %>
  </main>

</body>
</html>