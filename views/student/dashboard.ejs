
<div class="min-h-screen bg-[#0b0f19] text-slate-100 p-6 rounded-2xl space-y-6">
  
  <!-- Banner Section -->
  <div class="bg-[#161c2e] p-8 rounded-2xl border border-slate-800 flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
    <div>
      <span class="text-xs font-bold text-indigo-400 uppercase tracking-widest bg-indigo-500/10 px-3 py-1 rounded-full border border-indigo-500/20">Academic Session 2026</span>
      <h1 class="text-3xl font-extrabold text-white mt-2">College Academic Dashboard</h1>
      <p class="text-slate-400 text-sm mt-1">Track GPA, attendance status, tuition fees, course registrations, and library reservations in real-time.</p>
    </div>

    <div class="flex items-center gap-3">
      <a href="/student/download-report" class="bg-indigo-600 hover:bg-indigo-500 text-white font-semibold text-sm px-4 py-2.5 rounded-xl transition shadow-lg shadow-indigo-600/30 flex items-center gap-2">
        📄 Download PDF Marksheet
      </a>
      <a href="/student/faculties" class="bg-blue-600 hover:bg-blue-500 text-white font-semibold text-sm px-5 py-2.5 rounded-xl transition shadow-lg shadow-blue-600/30 flex items-center gap-2">
        🔍 Faculty Directory & Slots
      </a>
    </div>
  </div>

  <!-- Key Academic Metrics Grid -->
  <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
    
    <!-- CGPA Card -->
    <div class="bg-[#121725] p-5 rounded-2xl border border-slate-800/80">
      <div class="flex justify-between items-center text-slate-400 text-xs font-semibold uppercase">
        <span>Cumulative GPA</span>
        <span class="p-2 bg-indigo-500/10 text-indigo-400 rounded-lg">🎓</span>
      </div>
      <div class="mt-3">
        <span class="text-3xl font-extrabold text-white"><%= cgpa %></span>
        <span class="text-slate-500 text-sm"> / 10.0</span>
      </div>
      <p class="text-xs text-slate-400 mt-2">Current Semester: <%= student.semester %></p>
    </div>

    <!-- Attendance Card -->
    <div class="bg-[#121725] p-5 rounded-2xl border border-slate-800/80">
      <div class="flex justify-between items-center text-slate-400 text-xs font-semibold uppercase">
        <span>Total Attendance</span>
        <span class="p-2 bg-emerald-500/10 text-emerald-400 rounded-lg">📊</span>
      </div>
      <div class="mt-3">
        <span class="text-3xl font-extrabold text-white"><%= attendancePercentage %>%</span>
      </div>
      <div class="w-full bg-slate-800 h-1.5 rounded-full mt-3 overflow-hidden">
        <div class="bg-emerald-500 h-full rounded-full" style="width: <%= attendancePercentage %>%"></div>
      </div>
    </div>

    <!-- Fee Ledger Card -->
    <div class="bg-[#121725] p-5 rounded-2xl border border-slate-800/80">
      <div class="flex justify-between items-center text-slate-400 text-xs font-semibold uppercase">
        <span>Fee Status</span>
        <span class="p-2 bg-amber-500/10 text-amber-400 rounded-lg">💳</span>
      </div>
      <div class="mt-3">
        <% if (remainingFee > 0) { %>
          <span class="text-3xl font-extrabold text-amber-400">₹<%= remainingFee.toLocaleString() %></span>
          <span class="text-xs text-rose-400 font-semibold block mt-1">DUE REMAINING</span>
        <% } else { %>
          <span class="text-2xl font-extrabold text-emerald-400">NO DUES</span>
          <span class="text-xs text-emerald-500 font-semibold block mt-1">Full Paid</span>
        <% } %>
      </div>
    </div>

    <!-- Credits Earned Card -->
    <div class="bg-[#121725] p-5 rounded-2xl border border-slate-800/80">
      <div class="flex justify-between items-center text-slate-400 text-xs font-semibold uppercase">
        <span>Credits Earned</span>
        <span class="p-2 bg-blue-500/10 text-blue-400 rounded-lg">⏱️</span>
      </div>
      <div class="mt-3">
        <span class="text-3xl font-extrabold text-white"><%= creditsEarned %></span>
        <span class="text-slate-500 text-sm"> / 160</span>
      </div>
      <p class="text-xs text-slate-400 mt-2">Degree Requirement Progress</p>
    </div>
  </div>

  <!-- Alert Banner for Dues -->
  <% if (remainingFee > 0) { %>
    <div class="bg-amber-500/10 border border-amber-500/30 p-4 rounded-xl flex justify-between items-center text-amber-200 text-sm">
      <div class="flex items-center gap-3">
        <span>⚠️</span>
        <p><strong>Fee Reminder:</strong> Semester tuition fee of ₹<%= remainingFee.toLocaleString() %> is pending. Clear dues to avoid exam hall ticket hold.</p>
      </div>
    </div>
  <% } %>

  <!-- Academic Notices & Upcoming Exam Schedule -->
  <div class="bg-[#121725] p-6 rounded-2xl border border-slate-800/80 space-y-4">
    <h3 class="text-lg font-bold text-white flex items-center gap-2">
      🔔 Academic Notices & Upcoming Exam Schedule
    </h3>
    <div class="space-y-3">
      <% notices.forEach(n => { %>
        <div class="bg-[#181f33] p-4 rounded-xl border border-slate-800 flex justify-between items-start">
          <div>
            <h4 class="font-bold text-white text-base"><%= n.title %></h4>
            <p class="text-slate-400 text-xs mt-1"><%= n.content %></p>
          </div>
          <div class="text-right text-xs text-slate-500 whitespace-nowrap ml-4">
            <span class="block font-semibold text-indigo-400"><%= n.department %></span>
            <span><%= n.date %></span>
          </div>
        </div>
      <% }) %>
    </div>
  </div>
</div>