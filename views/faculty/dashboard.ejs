
<div class="space-y-6">
  <!-- Assigned Batch Banner -->
  <div class="bg-slate-900 text-white p-6 rounded-xl shadow-md flex justify-between items-center">
    <div>
      <h1 class="text-2xl font-bold">Faculty Portal — Prof. <%= user.name %></h1>
      <p class="text-slate-400 text-sm mt-1">
        Assigned Batch: <span class="bg-blue-600/30 text-blue-300 font-semibold px-2 py-0.5 rounded border border-blue-500/30"><%= faculty.assignedDepartment %></span> 
        | Semester: <span class="bg-blue-600/30 text-blue-300 font-semibold px-2 py-0.5 rounded border border-blue-500/30"><%= faculty.assignedSemester %></span> 
        | Subject: <span class="bg-indigo-600/30 text-indigo-300 font-semibold px-2 py-0.5 rounded border border-indigo-500/30"><%= faculty.assignedSubject %></span>
      </p>
    </div>
    <div class="text-right">
      <span class="text-xs text-slate-400 block uppercase font-bold tracking-wider">Assigned Roster</span>
      <span class="text-2xl font-bold text-emerald-400"><%= students.length %> Students</span>
    </div>
  </div>

  <% if (typeof message !== 'undefined' && message) { %>
    <div class="p-4 bg-emerald-50 border border-emerald-200 text-emerald-700 text-sm rounded-xl">
      <%= message %>
    </div>
  <% } %>

  <!-- Assigned Class Roster Table -->
  <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
    <div class="p-6 border-b border-slate-200 flex justify-between items-center">
      <h3 class="font-bold text-slate-800">Quick Academic Operations (<%= faculty.assignedSubject %>)</h3>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="bg-slate-50 text-slate-500 text-xs uppercase tracking-wider border-b border-slate-200">
            <th class="p-4">Roll Number</th>
            <th class="p-4">Student Name</th>
            <th class="p-4">Daily Attendance</th>
            <th class="p-4">Update Marks (/100)</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 text-sm">
          <% if (students && students.length > 0) { %>
            <% students.forEach(s => { %>
              <tr class="hover:bg-slate-50/80 transition">
                <td class="p-4 font-mono font-bold text-blue-600"><%= s.rollNumber %></td>
                <td class="p-4 font-medium text-slate-800"><%= s.userId ? s.userId.name : 'N/A' %></td>
                
                <td class="p-4">
                  <form action="/faculty/attendance" method="POST" class="flex items-center gap-2">
                    <input type="hidden" name="studentId" value="<%= s._id %>">
                    <button type="submit" name="status" value="Present" class="bg-emerald-100 hover:bg-emerald-200 text-emerald-800 text-xs font-semibold px-3 py-1.5 rounded transition">
                      ✓ Present
                    </button>
                    <button type="submit" name="status" value="Absent" class="bg-rose-100 hover:bg-rose-200 text-rose-800 text-xs font-semibold px-3 py-1.5 rounded transition">
                      ✕ Absent
                    </button>
                  </form>
                </td>

                <td class="p-4">
                  <form action="/faculty/result" method="POST" class="flex items-center gap-2">
                    <input type="hidden" name="studentId" value="<%= s._id %>">
                    <input type="number" name="marksObtained" min="0" max="100" required placeholder="85" class="w-20 p-1.5 border border-slate-300 rounded text-center text-xs font-semibold focus:ring-2 focus:ring-blue-500">
                    <button type="submit" class="bg-slate-800 hover:bg-slate-900 text-white text-xs font-semibold px-3 py-1.5 rounded transition">
                      Save
                    </button>
                  </form>
                </td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="4" class="p-6 text-center text-slate-400 text-sm">
                No students found in <%= faculty.assignedDepartment %> (Semester <%= faculty.assignedSemester %>). Log into the Admin Dashboard and seed mock data first.
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Faculty Availability & Office Hours Management Form -->
  <div class="bg-slate-900 p-6 rounded-xl border border-slate-800 text-white space-y-4">
    <h3 class="font-bold text-lg">Update Office Room & Weekly Free Hours</h3>
    <form action="/faculty/update-availability" method="POST" class="grid grid-cols-1 md:grid-cols-3 gap-4 text-xs">
      <div>
        <label class="block text-slate-400 mb-1">Room / Cabin Number</label>
        <input type="text" name="roomNumber" value="<%= faculty.roomNumber || 'Cabin-101' %>" required class="w-full bg-slate-800 border border-slate-700 p-2.5 rounded text-white focus:outline-none focus:border-indigo-500">
      </div>
      <div>
        <label class="block text-slate-400 mb-1">Weekly Available Free Hours</label>
        <input type="text" name="freeSlots" value="<%= faculty.freeSlots || 'Mon-Wed-Fri: 2:00 PM - 4:00 PM' %>" required class="w-full bg-slate-800 border border-slate-700 p-2.5 rounded text-white focus:outline-none focus:border-indigo-500">
      </div>
      <div class="flex items-center gap-2 pt-6">
        <input type="checkbox" name="isOnLeave" id="isOnLeave" <%= faculty.isOnLeave ? 'checked' : '' %> class="w-4 h-4 text-indigo-600 rounded">
        <label for="isOnLeave" class="text-slate-300 font-semibold cursor-pointer">Mark Profile as "On Leave"</label>
      </div>
      <div class="md:col-span-3 text-right pt-2">
        <button type="submit" class="bg-indigo-600 hover:bg-indigo-500 text-white font-bold px-5 py-2.5 rounded-lg transition">
          Save Availability Settings
        </button>
      </div>
    </form>
  </div>
</div>